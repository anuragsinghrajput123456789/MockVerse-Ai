# =============================================================================
# MockVerse(AI) Backend Environment Variables
# =============================================================================

# Server Environment & Port (Render assigns PORT automatically in production)
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local Development: mongodb://127.0.0.1:27017/mockverse
# Production (Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mockverse?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/mockverse"

# JWT Secret — Secret key used to sign and verify authentication tokens
# In production, generate a secure 64-byte random string:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-strong-random-secret"

# Google Gemini API Key (from https://aistudio.google.com/apikey)
# Used as the server-wide default key for AI paper generation and answer evaluation
GEMINI_API_KEY=""

# Gemini Model Override (optional — defaults to gemini-3.6-flash)
# GEMINI_MODEL="gemini-3.6-flash"

# Allowed Frontend URLs for CORS (required in production)
# Can be a single URL or comma-separated list of allowed origins
CLIENT_URL="https://your-mockverse-frontend.vercel.app"
# FRONTEND_URL="https://your-mockverse-frontend.vercel.app"

