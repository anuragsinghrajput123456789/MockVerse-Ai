# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/mockverse
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/mockverse
MONGODB_URI="mongodb://127.0.0.1:27017/mockverse"

# JWT Secret — MUST be a strong, unique random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-this-with-a-strong-random-secret"

# Google Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Gemini Model (optional override — defaults to gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.0-flash"

# Frontend URL (required for CORS in production)
# FRONTEND_URL="https://your-frontend-app.vercel.app"
